# SAFE LOCAL: copy to ignored .dev.vars for npm start.
# REQUIRES CLOUD AUTHORIZATION: set the same names on a preview Site.
# PRODUCTION FORBIDDEN: production D1, production secrets, ALLOW_LIVE, OPENAI_API_KEY.
# Values stay empty in Git. Generate new secrets; do not reuse production.
NEUROLENS_DEMO_DEPLOYMENT=preview
NEUROLENS_DEMO_D1_ISOLATED=1
NEUROLENS_DEMO_PASSWORD=
NEUROLENS_DEMO_SESSION_SECRET=
NEUROLENS_DEMO_RATE_SECRET=
NEUROLENS_DEMO_RATE_WINDOW_MS=60000
NEUROLENS_DEMO_RATE_LIMIT=30
NEUROLENS_DEMO_LOGIN_RATE_LIMIT=10
NEUROLENS_DEMO_SESSION_TTL_S=28800
NEUROLENS_DEMO_TRUST_CF_IP=1
NEUROLENS_AGENT_PROVIDER=mock
# Leave unset:
# NEUROLENS_AGENT_ALLOW_LIVE=
# OPENAI_API_KEY=
